DB_HOST=10.0.1.11
DB_PORT=8181
DB_USER=pf3user
DB_PASSWORD=pf3password
DB_NAME=PF3
OPCUA_URL=opc.tcp://172.30.30.10:4840
OPCUA_AUTH=
OPCUA_USERNAME=admin
OPCUA_PASSWORD=wago
OPCUA_TIMEOUT=20
# Mode de sécurité OPC UA: "None" (défaut) ou "SignAndEncrypt".
# Mettre OPCUA_AUTH=anonymous et vider les identifiants seulement si l'automate accepte Anonymous.
OPCUA_SECURITY_MODE=None
# Surcharges optionnelles des NodeIds CPU/RAM/Temp si l'espace OPC UA change.
OPCUA_NODE_CPU_LOAD=
OPCUA_NODE_RAM_USAGE=
OPCUA_NODE_TEMP_C=
# Chemins vers les certificats
OPCUA_CLIENT_CERT=app/certs/client_cert.der
OPCUA_CLIENT_KEY=app/certs/client_key.pem
OPCUA_SERVER_CERT=app/certs/server_cert.der
